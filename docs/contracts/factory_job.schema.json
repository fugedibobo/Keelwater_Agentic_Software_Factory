{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelwater.example/contracts/factory_job.schema.json",
  "title": "Keelwater factory job v1",
  "description": "Draft v1 of the contract between the product lifecycle layer and the platform team's engineering factory (docs/architecture.md section 4, ADR-011). A job carries evidence references and a de-identified problem statement only: verbatim customer quotes and account names stay in the intent document inside the VPC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "idempotency_key",
    "status",
    "action",
    "opportunity_id",
    "created_at",
    "created_by",
    "data_classification",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "$ref": "#/$defs/id"
    },
    "idempotency_key": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of opportunity_id, the evidence snapshot and the intent document version. The factory treats a repeated key as the same job."
    },
    "action": {
      "enum": [
        "create",
        "supersede",
        "cancel"
      ]
    },
    "supersedes": {
      "$ref": "#/$defs/id",
      "description": "job_id of the job this one replaces (supersede) or withdraws (cancel), for example after a PM merge."
    },
    "cancel_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "opportunity_id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "$ref": "#/$defs/actor"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "insight_ids",
        "run_manifest_hash",
        "intent_doc"
      ],
      "properties": {
        "insight_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Insight ids snapshotted at accept; resolvable to quotes only inside the VPC."
        },
        "run_manifest_hash": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_at": {
          "type": "string",
          "format": "date-time"
        },
        "intent_doc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handoff_id",
            "sha256"
          ],
          "properties": {
            "handoff_id": {
              "$ref": "#/$defs/id"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "problem_statement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000,
      "description": "De-identified: no quotes, customer, person or account names. A deterministic check rejects the job if any verified quote or account name appears in it."
    },
    "users_affected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tier",
          "accounts",
          "roles"
        ],
        "properties": {
          "tier": {
            "enum": [
              "Strategic",
              "Enterprise",
              "Growth",
              "prospect"
            ]
          },
          "accounts": {
            "type": "integer",
            "minimum": 1
          },
          "arr_band": {
            "enum": [
              "under_100k",
              "100k_500k",
              "500k_1m",
              "over_1m"
            ]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": "Job roles, for example claims handler or team leader; never names."
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "given",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[0-9]{1,3}$"
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "definition",
        "baseline",
        "target",
        "query"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "as_of"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "as_of": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "target": {
          "type": "number"
        },
        "window_days": {
          "type": "integer",
          "minimum": 1
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "sql",
                "metabase_question",
                "fullstory_metric"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_classification": {
      "enum": [
        "internal",
        "confidential"
      ],
      "description": "Restricted data (verbatim customer text, account or person names) is never placed in a job."
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "handoff_id",
        "run_id"
      ],
      "properties": {
        "opportunity_id": {
          "$ref": "#/$defs/id"
        },
        "handoff_id": {
          "$ref": "#/$defs/id"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "pull_requests": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "story_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "flag_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundle_id": {
          "type": "string"
        }
      },
      "description": "Opportunity -> job -> PR -> story -> flag -> bundle. The factory adds the downstream ids through status callbacks."
    },
    "gate_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "actor",
          "role",
          "approved_at"
        ],
        "properties": {
          "gate": {
            "enum": [
              "opportunity_accepted",
              "intent_approved"
            ]
          },
          "actor": {
            "$ref": "#/$defs/actor"
          },
          "role": {
            "enum": [
              "pm",
              "designer",
              "tech_lead"
            ]
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "submitted"
      ],
      "description": "draft while the intent document is being drafted; submitted once the Trio (PM, Designer, Tech Lead) has signed Gate 2 (done by the reviewer in the board for the demo). Gate approvals are required only when submitted."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "create",
              "supersede"
            ]
          }
        }
      },
      "then": {
        "required": [
          "evidence",
          "problem_statement",
          "users_affected",
          "acceptance_criteria",
          "outcome_metric",
          "constraints",
          "non_goals"
        ]
      }
    },
    {
      "if": {
        "required": [
          "status",
          "action"
        ],
        "properties": {
          "status": {
            "const": "submitted"
          },
          "action": {
            "enum": [
              "create",
              "supersede"
            ]
          }
        }
      },
      "then": {
        "required": [
          "gate_approvals"
        ],
        "properties": {
          "gate_approvals": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "gate": {
                      "const": "opportunity_accepted"
                    },
                    "role": {
                      "const": "pm"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "gate": {
                      "const": "intent_approved"
                    },
                    "role": {
                      "const": "pm"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "gate": {
                      "const": "intent_approved"
                    },
                    "role": {
                      "const": "designer"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "gate": {
                      "const": "intent_approved"
                    },
                    "role": {
                      "const": "tech_lead"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "supersede",
              "cancel"
            ]
          }
        }
      },
      "then": {
        "required": [
          "supersedes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "cancel"
          }
        }
      },
      "then": {
        "required": [
          "cancel_reason"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Full SHA-256 digest of a document or manifest."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "SSO subject in production; local user name in the demo."
    },
    "factory_response": {
      "description": "What the factory returns for a job. A rejection sends the opportunity back to accepted for redrafting.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "status",
        "at"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "reason_code": {
          "enum": [
            "ambiguous_criteria",
            "needs_split",
            "missing_metric",
            "out_of_scope",
            "other"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "required": [
          "reason_code",
          "message"
        ]
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "First 16 hex characters of the SHA-256 of the record's content keys."
    }
  }
}
